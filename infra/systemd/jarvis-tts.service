[Unit]
ConditionPathExists=!%h/Projects/jarvis-local/data/demo-mode
Description=JARVIS local Chatterbox V3 speech synthesis
StartLimitIntervalSec=600
StartLimitBurst=2
[Service]
WorkingDirectory=%h/Projects/jarvis-local
ExecStart=/bin/bash %h/Projects/jarvis-local/scripts/speech_service.sh tts
ExecStop=/usr/bin/docker stop -t 20 jarvis-tts
Restart=on-failure
RestartSec=20
TimeoutStopSec=30
UMask=0077
[Install]
WantedBy=default.target
