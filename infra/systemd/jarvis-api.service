[Unit]
Description=JARVIS private core API
[Service]
WorkingDirectory=%h/Projects/jarvis-local
EnvironmentFile=%h/Projects/jarvis-local/secrets/runtime.env
ExecStart=%h/Projects/jarvis-local/.venv/bin/uvicorn jarvis.api:app --host 127.0.0.1 --port 8100 --no-access-log
Restart=on-failure
RestartSec=5
# Let API lifespan cancel Outlook reads and close the owned tab before its
# Playwright child exits. Timeout escalation still kills the entire cgroup.
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=default.target
